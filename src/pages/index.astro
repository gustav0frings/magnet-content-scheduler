---
export const prerender = false;

import "../styles/global.css";
import {
  COUNTRY_CODES,
  COUNTRY_FLAGS,
  countriesFrom,
  countryFlag,
  listDevices,
} from "../lib/devices";
import { COOKIE_DEVICE, COOKIE_LANG, messages, UI_LANGS } from "../lib/i18n";
import { inDefaultWindow, listItems } from "../lib/schedule";
import type { ScheduleItem } from "../lib/types";

const devices = await listDevices();
const all = inDefaultWindow(await listItems());

const start = new Date();
start.setHours(0, 0, 0, 0);
const days: {
  key: string;
  date: Date;
  isToday: boolean;
  items: ScheduleItem[];
}[] = [];
for (let i = 0; i < 8; i++) {
  const d = new Date(start);
  d.setDate(d.getDate() + i);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  days.push({
    key: `${y}-${m}-${day}`,
    date: d,
    isToday: i === 0,
    items: [],
  });
}

for (const item of all) {
  const local = new Date(item.publishAt);
  const y = local.getFullYear();
  const m = String(local.getMonth() + 1).padStart(2, "0");
  const day = String(local.getDate()).padStart(2, "0");
  const key = `${y}-${m}-${day}`;
  const bucket = days.find((d) => d.key === key);
  if (bucket) bucket.items.push(item);
}

const countryList = countriesFrom(devices);
const boot = {
  devices,
  countries: COUNTRY_CODES,
  flags: COUNTRY_FLAGS,
  langs: UI_LANGS,
  messages,
  cookieLang: COOKIE_LANG,
  cookieDevice: COOKIE_DEVICE,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Magnet · Content Scheduler</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Serif:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap" id="app" hidden>
      <header>
        <div class="header-row">
          <div>
            <h1 data-i18n="title">Content Scheduler</h1>
            <p data-i18n="subtitle">Your videos for the next 7 days.</p>
          </div>
          <button type="button" class="linkish" id="reopen-setup" data-i18n="changeSetup">
            Change device / language
          </button>
        </div>
      </header>

      <div class="pickers">
        <label class="field">
          <span data-i18n="device">Device</span>
          <select id="device" aria-label="Device">
            <option value="" data-i18n-option="allDevices">All devices</option>
            {devices.map((d) => (
              <option value={d.id}>
                {countryFlag(d.country)} {d.name}
              </option>
            ))}
          </select>
        </label>
        <label class="field">
          <span data-i18n="language">Language</span>
          <select id="lang" aria-label="Language">
            {UI_LANGS.map((l) => (
              <option value={l.id}>{l.label}</option>
            ))}
          </select>
        </label>
        <label class="field">
          <span data-i18n="country">Country</span>
          <select id="country" aria-label="Country">
            <option value="" data-i18n-option="allCountries">All countries</option>
            {countryList.map((c) => (
              <option value={c}>
                {countryFlag(c)} {c}
              </option>
            ))}
          </select>
        </label>
      </div>

      <p class="range" id="range-hint"></p>

      <div id="calendar">
        {
          days.map((day) => (
            <section
              class:list={["day", { today: day.isToday }]}
              data-day={day.key}
              data-is-today={day.isToday ? "1" : "0"}
              data-date={day.date.toISOString()}
            >
              <h2 data-day-label></h2>
              {day.items.length === 0 ? (
                <p class="empty" data-empty data-i18n="empty">
                  —
                </p>
              ) : (
                <div class="day-grid">
                  {day.items.map((item) => {
                    const device = devices.find((d) => d.id === item.deviceId);
                    const downloadName = `${item.title}.mp4`;
                    const downloadHref = `/api/download?url=${encodeURIComponent(item.url)}&name=${encodeURIComponent(downloadName)}`;
                    return (
                      <article
                        class="card"
                        data-device={item.deviceId}
                        data-country={item.country}
                        data-publish={item.publishAt}
                      >
                        <a
                          class="thumb"
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={item.title}
                        >
                          <video
                            src={`${item.url}#t=0.1`}
                            muted
                            playsinline
                            preload="metadata"
                            aria-hidden="true"
                          />
                        </a>
                        <div class="card-body">
                          <strong>{item.title}</strong>
                          <div class="meta">
                            <span data-time></span>
                            <span class={`badge ${item.country}`} title={item.country}>
                              {countryFlag(item.country)}
                            </span>
                            <span class="device-name">{device?.name ?? item.deviceId}</span>
                            {item.savedAt ? (
                              <span data-i18n="saved">saved</span>
                            ) : null}
                          </div>
                          <a class="download" href={downloadHref} download={downloadName} data-i18n="download">
                            Download
                          </a>
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}
            </section>
          ))
        }
      </div>

      <p class="footer">
        <span data-i18n="footer">Inbox API</span>: <code>/api/inbox/&lt;deviceId&gt;</code>
      </p>
    </div>

    <div class="modal" id="setup-modal" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <h2 id="modal-title" data-i18n="modalTitle">Welcome</h2>

        <div class="modal-step" id="step-lang">
          <p class="modal-label" data-i18n="modalLang">Choose your language</p>
          <div class="choice-grid" id="lang-choices">
            {UI_LANGS.map((l) => (
              <button type="button" class="choice" data-lang={l.id}>
                {l.label}
              </button>
            ))}
          </div>
          <button type="button" class="primary" id="lang-next" disabled data-i18n="modalNext">
            Next
          </button>
        </div>

        <div class="modal-step" id="step-device" hidden>
          <p class="modal-label" data-i18n="modalDevice">Choose your device</p>
          <label class="field modal-device-field" id="modal-device-field">
            <select id="modal-device" aria-label="Device">
              <option value="">—</option>
            </select>
          </label>

          <button type="button" class="linkish register-toggle" id="show-register" data-i18n="modalRegister">
            Not in the list? Register a new device
          </button>

          <div class="register-form" id="register-form" hidden>
            <label class="field">
              <span data-i18n="modalRegisterName">Device name</span>
              <input id="reg-name" type="text" autocomplete="off" maxlength="40" />
            </label>
            <label class="field">
              <span data-i18n="modalRegisterCountry">Country</span>
              <select id="reg-country">
                {COUNTRY_CODES.map((c) => (
                  <option value={c}>
                    {countryFlag(c)} {c}
                  </option>
                ))}
              </select>
            </label>
            <p class="register-error" id="reg-error" hidden></p>
            <button type="button" class="primary" id="reg-submit" data-i18n="modalRegisterSubmit">
              Register & continue
            </button>
            <button type="button" class="linkish register-back" id="reg-back" data-i18n="modalRegisterBack">
              ← Back to device list
            </button>
          </div>

          <button type="button" class="primary" id="device-done" disabled data-i18n="modalContinue">
            Continue
          </button>
        </div>
      </div>
    </div>

    <script define:vars={{ boot }}>
      const cfg = boot;
      let devices = [...cfg.devices];
      const tAll = cfg.messages;
      const flags = cfg.flags || {};

      function flag(country) {
        return flags[country] || country;
      }

      function fill(template, vars) {
        return template.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");
      }

      function getCookie(name) {
        const m = document.cookie.match(
          new RegExp("(?:^|; )" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "=([^;]*)"),
        );
        return m ? decodeURIComponent(m[1]) : "";
      }

      function setCookie(name, value, days = 400) {
        if (!value) return; // never wipe lang/device with an empty value
        const maxAge = days * 24 * 60 * 60;
        const secure = location.protocol === "https:" ? "; Secure" : "";
        document.cookie = `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
      }

      function localeFor(lang) {
        return lang === "fr" ? "fr-FR" : "en-GB";
      }

      let lang = getCookie(cfg.cookieLang) === "fr" ? "fr" : getCookie(cfg.cookieLang) === "en" ? "en" : "";
      let deviceId = getCookie(cfg.cookieDevice) || "";
      let pendingLang = lang || "en";
      let pendingDevice = deviceId;

      const app = document.getElementById("app");
      const modal = document.getElementById("setup-modal");
      const stepLang = document.getElementById("step-lang");
      const stepDevice = document.getElementById("step-device");
      const langNext = document.getElementById("lang-next");
      const deviceDone = document.getElementById("device-done");
      const deviceSelect = document.getElementById("device");
      const countrySelect = document.getElementById("country");
      const langSelect = document.getElementById("lang");
      const hint = document.getElementById("range-hint");
      const modalDevice = document.getElementById("modal-device");
      const showRegister = document.getElementById("show-register");
      const registerForm = document.getElementById("register-form");
      const modalDeviceField = document.getElementById("modal-device-field");
      const regName = document.getElementById("reg-name");
      const regCountry = document.getElementById("reg-country");
      const regSubmit = document.getElementById("reg-submit");
      const regBack = document.getElementById("reg-back");
      const regError = document.getElementById("reg-error");

      function showPickDevice() {
        registerForm.hidden = true;
        regError.hidden = true;
        modalDeviceField.hidden = false;
        showRegister.hidden = false;
        deviceDone.hidden = false;
        deviceDone.disabled = !pendingDevice;
      }

      function showRegisterDevice() {
        pendingDevice = "";
        modalDevice.value = "";
        registerForm.hidden = false;
        regError.hidden = true;
        modalDeviceField.hidden = true;
        showRegister.hidden = true;
        deviceDone.hidden = true;
        deviceDone.disabled = true;
        regName.focus();
      }

      function t() {
        return tAll[lang || pendingLang || "en"];
      }

      function syncDeviceSelect() {
        const allLabel = t().allDevices;
        const current = deviceSelect.value;
        deviceSelect.innerHTML = "";
        const allOpt = document.createElement("option");
        allOpt.value = "";
        allOpt.setAttribute("data-i18n-option", "allDevices");
        allOpt.textContent = allLabel;
        deviceSelect.appendChild(allOpt);
        for (const d of devices) {
          const opt = document.createElement("option");
          opt.value = d.id;
          opt.textContent = `${flag(d.country)} ${d.name}`;
          deviceSelect.appendChild(opt);
        }
        if ([...deviceSelect.options].some((o) => o.value === current)) {
          deviceSelect.value = current;
        } else if (deviceId) {
          deviceSelect.value = deviceId;
        }

        const countries = [...new Set(devices.map((d) => d.country))];
        const cCur = countrySelect.value;
        countrySelect.innerHTML = "";
        const cAll = document.createElement("option");
        cAll.value = "";
        cAll.setAttribute("data-i18n-option", "allCountries");
        cAll.textContent = t().allCountries;
        countrySelect.appendChild(cAll);
        for (const c of countries) {
          const opt = document.createElement("option");
          opt.value = c;
          opt.textContent = `${flag(c)} ${c}`;
          countrySelect.appendChild(opt);
        }
        if ([...countrySelect.options].some((o) => o.value === cCur)) {
          countrySelect.value = cCur;
        }
      }

      function renderDeviceChoices() {
        const placeholder = t().modalDevice;
        modalDevice.innerHTML = "";
        const empty = document.createElement("option");
        empty.value = "";
        empty.textContent = `— ${placeholder} —`;
        modalDevice.appendChild(empty);
        for (const d of devices) {
          const opt = document.createElement("option");
          opt.value = d.id;
          opt.textContent = `${flag(d.country)} ${d.name}`;
          modalDevice.appendChild(opt);
        }
        if (pendingDevice && [...modalDevice.options].some((o) => o.value === pendingDevice)) {
          modalDevice.value = pendingDevice;
        } else {
          modalDevice.value = "";
          pendingDevice = "";
        }
        deviceDone.disabled = !pendingDevice;
      }

      function applyI18n() {
        const m = t();
        const loc = localeFor(lang || pendingLang || "en");
        document.documentElement.lang = lang || pendingLang || "en";

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          const val = m[key];
          if (typeof val === "string") el.textContent = val;
        });

        document.querySelectorAll("[data-i18n-option]").forEach((el) => {
          const key = el.getAttribute("data-i18n-option");
          const val = m[key];
          if (typeof val === "string") el.textContent = val;
        });

        document.querySelectorAll("[data-day-label]").forEach((h2) => {
          const section = h2.closest(".day");
          const iso = section.getAttribute("data-date");
          const isToday = section.getAttribute("data-is-today") === "1";
          const d = new Date(iso);
          const label = d.toLocaleDateString(loc, {
            weekday: "short",
            day: "numeric",
            month: "short",
          });
          h2.textContent = isToday ? `${m.today} · ${label}` : label;
        });

        document.querySelectorAll(".card").forEach((card) => {
          const publish = card.getAttribute("data-publish");
          const timeEl = card.querySelector("[data-time]");
          if (timeEl && publish) {
            timeEl.textContent = new Date(publish).toLocaleTimeString(loc, {
              hour: "2-digit",
              minute: "2-digit",
            });
          }
        });

        if (langSelect && lang) langSelect.value = lang;
      }

      function applyFilters() {
        deviceId = deviceSelect.value || "";
        const country = countrySelect.value || "";
        const m = t();
        const device = devices.find((d) => d.id === deviceId);

        hint.textContent = device
          ? fill(m.showingDevice, {
              name: device.name,
              country: flag(device.country),
            })
          : country
            ? fill(m.showingCountry, { country: flag(country) })
            : m.showingAll;

        document.querySelectorAll(".card").forEach((card) => {
          const cardDevice = card.getAttribute("data-device") || "";
          const cardCountry = card.getAttribute("data-country") || "";
          const okDevice = !deviceId || cardDevice === deviceId;
          const okCountry = !country || cardCountry === country;
          card.hidden = !(okDevice && okCountry);
        });

        document.querySelectorAll(".day").forEach((section) => {
          const cards = [...section.querySelectorAll(".card")];
          const visible = cards.filter((c) => !c.hidden);
          const empty = section.querySelector("[data-empty]");
          if (empty) empty.hidden = visible.length > 0;
        });
      }

      function finishWithDevice(id) {
        deviceId = id;
        pendingDevice = id;
        setCookie(cfg.cookieDevice, deviceId);
        showApp();
      }

      function showApp() {
        modal.hidden = true;
        app.hidden = false;
        syncDeviceSelect();
        // Default view = cookie device (select + country stay in sync).
        // User can still switch the dropdown to "all devices".
        const saved = getCookie(cfg.cookieDevice) || deviceId || "";
        const d = devices.find((x) => x.id === saved);
        if (d) {
          deviceSelect.value = d.id;
          countrySelect.value = d.country;
          deviceId = d.id;
        } else {
          deviceSelect.value = "";
          countrySelect.value = "";
          deviceId = "";
        }
        applyI18n();
        applyFilters();
      }

      function openSetup(force = false) {
        const needLang = force || !getCookie(cfg.cookieLang);
        const needDevice = force || !getCookie(cfg.cookieDevice);
        if (!needLang && !needDevice && !force) {
          showApp();
          return;
        }
        app.hidden = true;
        modal.hidden = false;
        pendingLang = lang || "en";
        pendingDevice = deviceId || "";
        stepLang.hidden = false;
        stepDevice.hidden = true;
        langNext.disabled = !pendingLang;
        renderDeviceChoices();
        showPickDevice();
        document.querySelectorAll("#lang-choices .choice").forEach((b) => {
          b.classList.toggle("selected", b.dataset.lang === pendingLang);
        });
        applyI18n();
      }

      document.querySelectorAll("#lang-choices .choice").forEach((btn) => {
        btn.addEventListener("click", () => {
          pendingLang = btn.dataset.lang;
          document.querySelectorAll("#lang-choices .choice").forEach((b) => {
            b.classList.toggle("selected", b === btn);
          });
          langNext.disabled = false;
          applyI18n();
        });
      });

      langNext.addEventListener("click", () => {
        lang = pendingLang;
        setCookie(cfg.cookieLang, lang);
        stepLang.hidden = true;
        stepDevice.hidden = false;
        renderDeviceChoices();
        applyI18n();
      });

      modalDevice.addEventListener("change", () => {
        pendingDevice = modalDevice.value || "";
        if (pendingDevice) showPickDevice();
        else deviceDone.disabled = true;
      });

      showRegister.addEventListener("click", () => {
        showRegisterDevice();
      });

      regBack.addEventListener("click", () => {
        showPickDevice();
      });

      function normalizeNameLive(raw) {
        return raw
          .toLowerCase()
          .replace(/\s+/g, "-")
          .replace(/[^a-z0-9-]+/g, "-")
          .replace(/-+/g, "-");
      }

      regName.addEventListener("input", () => {
        const start = regName.selectionStart;
        const next = normalizeNameLive(regName.value);
        if (next !== regName.value) {
          regName.value = next;
          const pos = Math.min(start, next.length);
          regName.setSelectionRange(pos, pos);
        }
      });

      regSubmit.addEventListener("click", async () => {
        const name = normalizeNameLive(regName.value).replace(/^-|-$/g, "");
        regName.value = name;
        const country = regCountry.value;
        regError.hidden = true;
        if (!name) {
          regError.textContent = t().modalRegisterError;
          regError.hidden = false;
          return;
        }
        regSubmit.disabled = true;
        try {
          const res = await fetch("/api/devices", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ name, country }),
          });
          const body = await res.json();
          if (!res.ok) throw new Error(body.error || "failed");
          devices.push(body.device);
          devices.sort((a, b) => a.name.localeCompare(b.name));
          finishWithDevice(body.device.id);
        } catch (err) {
          regError.textContent = t().modalRegisterError;
          regError.hidden = false;
        } finally {
          regSubmit.disabled = false;
        }
      });

      deviceDone.addEventListener("click", () => {
        if (!pendingDevice) return;
        finishWithDevice(pendingDevice);
      });

      deviceSelect.addEventListener("change", () => {
        deviceId = deviceSelect.value;
        // Keep the last real device in the cookie — "all devices" is a view
        // filter only, otherwise the next visit thinks setup is missing.
        if (deviceId) setCookie(cfg.cookieDevice, deviceId);
        const d = devices.find((x) => x.id === deviceId);
        // Sync country with the picked device; clear it for "all devices"
        // so FR + US (etc.) all show up.
        countrySelect.value = d ? d.country : "";
        applyFilters();
      });

      countrySelect.addEventListener("change", applyFilters);

      langSelect.addEventListener("change", () => {
        lang = langSelect.value;
        setCookie(cfg.cookieLang, lang);
        applyI18n();
        applyFilters();
      });

      document.getElementById("reopen-setup").addEventListener("click", () => {
        openSetup(true);
      });

      if (!getCookie(cfg.cookieLang) || !getCookie(cfg.cookieDevice)) {
        openSetup(false);
      } else {
        lang = getCookie(cfg.cookieLang) === "fr" ? "fr" : "en";
        deviceId = getCookie(cfg.cookieDevice);
        showApp(); // filters on cookie device by default
      }
    </script>
  </body>
</html>
