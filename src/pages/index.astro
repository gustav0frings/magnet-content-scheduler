---
export const prerender = false;

import "../styles/global.css";
import {
  COUNTRY_CODES,
  COUNTRY_FLAGS,
  countriesFrom,
  countryFlag,
  listDevices,
} from "../lib/devices";
import { COOKIE_DEVICE, COOKIE_LANG, messages, UI_LANGS } from "../lib/i18n";
import { PLATFORM_ICON } from "../lib/platform-icons";
import { listItems } from "../lib/schedule";

const devices = await listDevices();
const items = await listItems();

const countryList = countriesFrom(devices);
const boot = {
  devices,
  items,
  countries: COUNTRY_CODES,
  flags: COUNTRY_FLAGS,
  platformIcons: PLATFORM_ICON,
  langs: UI_LANGS,
  messages,
  cookieLang: COOKIE_LANG,
  cookieDevice: COOKIE_DEVICE,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Magnet · Content Scheduler</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Serif:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap" id="app" hidden>
      <header>
        <div class="header-row">
          <div>
            <h1 data-i18n="title">Content Scheduler</h1>
            <p data-i18n="subtitle">Your videos for the next 7 days.</p>
          </div>
          <div class="header-actions">
            <nav class="nav-links">
              <a href="/" class="nav-current" data-i18n="navCalendar">Calendar</a>
              <a href="/accounts" data-i18n="navAccounts">Accounts</a>
            </nav>
            <button type="button" class="linkish" id="reopen-setup" data-i18n="changeSetup">
              Change account / language
            </button>
          </div>
        </div>
      </header>

      <div class="pickers">
        <label class="field">
          <span data-i18n="device">Account</span>
          <select id="device" aria-label="Account">
            <option value="" data-i18n-option="allDevices">All accounts</option>
            {devices.map((d) => (
              <option value={d.id}>
                {countryFlag(d.country)} {d.name}
              </option>
            ))}
          </select>
        </label>
        <label class="field">
          <span data-i18n="language">Language</span>
          <select id="lang" aria-label="Language">
            {UI_LANGS.map((l) => (
              <option value={l.id}>{l.label}</option>
            ))}
          </select>
        </label>
        <label class="field">
          <span data-i18n="country">Country</span>
          <select id="country" aria-label="Country">
            <option value="" data-i18n-option="allCountries">All countries</option>
            {countryList.map((c) => (
              <option value={c}>
                {countryFlag(c)} {c}
              </option>
            ))}
          </select>
        </label>
      </div>

      <div class="week-nav">
        <button type="button" class="week-btn" id="week-prev" data-i18n="weekPrev">
          ← 7 days
        </button>
        <span class="week-label" id="week-label"></span>
        <button type="button" class="week-btn" id="week-next" data-i18n="weekNext">
          7 days →
        </button>
        <button type="button" class="week-btn week-this" id="week-this" hidden data-i18n="weekThis">
          This week
        </button>
      </div>

      <p class="range" id="range-hint"></p>

      <div id="calendar"></div>

      <p class="footer">
        <span data-i18n="footer">Inbox API</span>: <code>/api/inbox/&lt;deviceId&gt;</code>
      </p>
    </div>

    <div class="modal" id="setup-modal" hidden>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <h2 id="modal-title" data-i18n="modalTitle">Welcome</h2>

        <div class="modal-step" id="step-lang">
          <p class="modal-label" data-i18n="modalLang">Choose your language</p>
          <div class="choice-grid" id="lang-choices">
            {UI_LANGS.map((l) => (
              <button type="button" class="choice" data-lang={l.id}>
                {l.label}
              </button>
            ))}
          </div>
          <button type="button" class="primary" id="lang-next" disabled data-i18n="modalNext">
            Next
          </button>
        </div>

        <div class="modal-step" id="step-device" hidden>
          <p class="modal-label" data-i18n="modalDevice">Choose your account</p>
          <label class="field modal-device-field" id="modal-device-field">
            <select id="modal-device" aria-label="Account">
              <option value="">—</option>
            </select>
          </label>

          <button type="button" class="linkish register-toggle" id="show-register" data-i18n="modalRegister">
            Not in the list? Register a new account
          </button>

          <div class="register-form" id="register-form" hidden>
            <label class="field">
              <span data-i18n="modalRegisterName">Account name</span>
              <input id="reg-name" type="text" autocomplete="off" maxlength="40" />
            </label>
            <label class="field">
              <span data-i18n="modalRegisterPlatform">Platform</span>
              <select id="reg-platform">
                <option value="tiktok" data-i18n-option="accountPlatformTiktok">TikTok</option>
                <option value="instagram" data-i18n-option="accountPlatformInstagram">Instagram</option>
              </select>
            </label>
            <label class="field">
              <span data-i18n="modalRegisterCountry">Country</span>
              <select id="reg-country">
                {COUNTRY_CODES.map((c) => (
                  <option value={c}>
                    {countryFlag(c)} {c}
                  </option>
                ))}
              </select>
            </label>
            <p class="register-error" id="reg-error" hidden></p>
            <button type="button" class="primary" id="reg-submit" data-i18n="modalRegisterSubmit">
              Register & continue
            </button>
            <button type="button" class="linkish register-back" id="reg-back" data-i18n="modalRegisterBack">
              ← Back to account list
            </button>
          </div>

          <button type="button" class="primary" id="device-done" disabled data-i18n="modalContinue">
            Continue
          </button>
        </div>
      </div>
    </div>

    <script define:vars={{ boot }}>
      const cfg = boot;
      let devices = [...cfg.devices];
      const items = [...(cfg.items || [])];
      const tAll = cfg.messages;
      const flags = cfg.flags || {};
      const platformIcons = cfg.platformIcons || {
        instagram: "/icons/instagram.png",
        tiktok: "/icons/tiktok.png",
      };
      let weekOffset = 0; // days from today (multiples of 7)

      function flag(country) {
        return flags[country] || country;
      }

      function platformIconEl(platform) {
        const key = platform === "instagram" ? "instagram" : "tiktok";
        const el = document.createElement("span");
        el.className = "platform-icon";
        el.dataset.platform = key;
        el.setAttribute("role", "img");
        el.setAttribute("aria-label", key === "instagram" ? "Instagram" : "TikTok");
        el.style.setProperty("--icon", `url('${platformIcons[key]}')`);
        return el;
      }

      function accountLabel(device) {
        if (!device) return "";
        const wrap = document.createElement("span");
        wrap.className = "account-with-icon";
        wrap.appendChild(platformIconEl(device.platform));
        wrap.appendChild(document.createTextNode(device.name));
        return wrap;
      }

      function dayKey(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, "0");
        const d = String(date.getDate()).padStart(2, "0");
        return `${y}-${m}-${d}`;
      }

      function startOfView() {
        const start = new Date();
        start.setHours(0, 0, 0, 0);
        start.setDate(start.getDate() + weekOffset);
        return start;
      }

      function updateWeekChrome() {
        const loc = localeFor(lang || pendingLang || "en");
        const start = startOfView();
        const end = new Date(start);
        end.setDate(end.getDate() + 7);
        const fmt = { day: "numeric", month: "short" };
        weekLabel.textContent = `${start.toLocaleDateString(loc, fmt)} – ${end.toLocaleDateString(loc, fmt)}`;
        weekThis.hidden = weekOffset === 0;
      }

      async function persistPublished(id, published) {
        const res = await fetch("/api/items/published", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id, published }),
          keepalive: true,
        });
        if (!res.ok) throw new Error("failed");
        const body = await res.json();
        const item = items.find((i) => i.id === id);
        if (item) item.publishedAt = body.item?.publishedAt ?? null;
      }

      function paintPublished(card, on) {
        const m = t();
        card.dataset.published = on ? "1" : "0";
        card.classList.toggle("is-published", on);
        const toggle = card.querySelector(".publish-toggle");
        if (toggle) {
          toggle.classList.toggle("is-on", on);
          toggle.setAttribute("aria-pressed", on ? "true" : "false");
          toggle.setAttribute("aria-label", on ? m.unmarkPublished : m.markPublished);
        }
        const status = card.querySelector("[data-status]");
        if (status) {
          status.setAttribute("data-i18n", on ? "published" : "unpublished");
          status.textContent = on ? m.published : m.unpublished;
        }
        const dl = card.querySelector("a.download");
        if (dl) {
          dl.classList.toggle("is-published", on);
          if (on) {
            dl.setAttribute("aria-disabled", "true");
            dl.removeAttribute("href");
          } else {
            dl.removeAttribute("aria-disabled");
            if (dl.dataset.href) dl.href = dl.dataset.href;
          }
        }
      }

      async function togglePublished(card, id) {
        const next = card.dataset.published !== "1";
        const toggle = card.querySelector(".publish-toggle");
        if (toggle) toggle.disabled = true;
        paintPublished(card, next);
        try {
          await persistPublished(id, next);
        } catch {
          paintPublished(card, !next);
        } finally {
          if (toggle) toggle.disabled = false;
        }
      }

      async function onDownload(event, card, id) {
        if (card.dataset.published === "1") {
          event.preventDefault();
          return;
        }
        // Keep href for this click so the file still downloads (iPhone included).
        const m = t();
        card.dataset.published = "1";
        card.classList.add("is-published");
        const toggle = card.querySelector(".publish-toggle");
        if (toggle) {
          toggle.classList.add("is-on");
          toggle.setAttribute("aria-pressed", "true");
          toggle.setAttribute("aria-label", m.unmarkPublished);
        }
        const status = card.querySelector("[data-status]");
        if (status) {
          status.setAttribute("data-i18n", "published");
          status.textContent = m.published;
        }
        try {
          await persistPublished(id, true);
          paintPublished(card, true);
        } catch {
          paintPublished(card, false);
        }
      }

      function renderCalendar() {
        const cal = document.getElementById("calendar");
        const start = startOfView();
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const m = t();
        cal.innerHTML = "";

        for (let i = 0; i < 8; i++) {
          const d = new Date(start);
          d.setDate(d.getDate() + i);
          const key = dayKey(d);
          const isToday = d.getTime() === today.getTime();
          const dayItems = items.filter((it) => dayKey(new Date(it.publishAt)) === key);

          const section = document.createElement("section");
          section.className = isToday ? "day today" : "day";
          section.dataset.day = key;
          section.dataset.isToday = isToday ? "1" : "0";
          section.dataset.date = d.toISOString();

          const h2 = document.createElement("h2");
          h2.setAttribute("data-day-label", "");
          section.appendChild(h2);

          const empty = document.createElement("p");
          empty.className = "empty";
          empty.setAttribute("data-empty", "");
          empty.setAttribute("data-i18n", "empty");
          empty.textContent = m.empty;
          empty.hidden = dayItems.length > 0;
          section.appendChild(empty);

          if (dayItems.length > 0) {
            const grid = document.createElement("div");
            grid.className = "day-grid";
            for (const item of dayItems) {
              const accountIds = (
                item.deviceIds?.length ? item.deviceIds : [item.deviceId]
              ).filter(Boolean);
              const linked = accountIds
                .map((id) => devices.find((x) => x.id === id))
                .filter(Boolean);
              const countries = [
                ...new Set(
                  [
                    ...linked.map((d) => d.country),
                    item.country,
                  ].filter(Boolean),
                ),
              ];
              const downloadName = `${item.title}.mp4`;
              const downloadHref = `/api/download?url=${encodeURIComponent(item.url)}&name=${encodeURIComponent(downloadName)}`;

              const published = Boolean(item.publishedAt);
              const card = document.createElement("article");
              card.className = published ? "card is-published" : "card";
              card.dataset.device = accountIds[0] || "";
              card.dataset.devices = accountIds.join(",");
              card.dataset.country = countries[0] || item.country || "";
              card.dataset.countries = countries.join(",");
              card.dataset.publish = item.publishAt;
              card.dataset.published = published ? "1" : "0";
              card.dataset.id = item.id;

              const thumb = document.createElement("a");
              thumb.className = "thumb";
              thumb.href = item.url;
              thumb.target = "_blank";
              thumb.rel = "noopener noreferrer";
              thumb.setAttribute("aria-label", item.title);
              const video = document.createElement("video");
              video.src = `${item.url}#t=0.1`;
              video.muted = true;
              video.playsInline = true;
              video.preload = "metadata";
              video.setAttribute("aria-hidden", "true");
              thumb.appendChild(video);
              card.appendChild(thumb);

              const body = document.createElement("div");
              body.className = "card-body";
              const title = document.createElement("strong");
              title.textContent = item.title;
              body.appendChild(title);

              const meta = document.createElement("div");
              meta.className = "meta";
              const time = document.createElement("span");
              time.setAttribute("data-time", "");
              meta.appendChild(time);
              for (const c of countries) {
                const badge = document.createElement("span");
                badge.className = `badge ${c}`;
                badge.title = c;
                badge.textContent = flag(c);
                meta.appendChild(badge);
              }
              if (item.savedAt) {
                const saved = document.createElement("span");
                saved.setAttribute("data-i18n", "saved");
                saved.textContent = m.saved;
                meta.appendChild(saved);
              }
              body.appendChild(meta);

              const chips = document.createElement("div");
              chips.className = "account-chips";
              for (const d of linked) {
                const chip = accountLabel(d);
                const country = document.createElement("span");
                country.className = "chip-flag";
                country.textContent = flag(d.country);
                chip.prepend(country);
                chips.appendChild(chip);
              }
              if (linked.length === 0 && accountIds.length > 0) {
                for (const id of accountIds) {
                  const fallback = document.createElement("span");
                  fallback.className = "account-with-icon";
                  fallback.textContent = id;
                  chips.appendChild(fallback);
                }
              }
              body.appendChild(chips);

              const publishRow = document.createElement("div");
              publishRow.className = "publish-row";
              const toggle = document.createElement("button");
              toggle.type = "button";
              toggle.className = published ? "publish-toggle is-on" : "publish-toggle";
              toggle.setAttribute("aria-pressed", published ? "true" : "false");
              toggle.setAttribute(
                "aria-label",
                published ? m.unmarkPublished : m.markPublished,
              );
              toggle.textContent = "✓";
              toggle.addEventListener("click", () => {
                togglePublished(card, item.id);
              });
              const status = document.createElement("span");
              status.className = "status-label";
              status.setAttribute("data-status", "");
              status.setAttribute("data-i18n", published ? "published" : "unpublished");
              status.textContent = published ? m.published : m.unpublished;
              publishRow.append(toggle, status);
              body.appendChild(publishRow);

              const dl = document.createElement("a");
              dl.className = published ? "download is-published" : "download";
              dl.dataset.href = downloadHref;
              if (published) dl.setAttribute("aria-disabled", "true");
              else dl.href = downloadHref;
              dl.setAttribute("download", downloadName);
              dl.setAttribute("data-i18n", "download");
              dl.textContent = m.download;
              dl.addEventListener("click", (event) => {
                onDownload(event, card, item.id);
              });
              body.appendChild(dl);

              card.appendChild(body);
              grid.appendChild(card);
            }
            section.appendChild(grid);
          }

          cal.appendChild(section);
        }

        updateWeekChrome();
      }

      function fill(template, vars) {
        return template.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");
      }

      function getCookie(name) {
        const m = document.cookie.match(
          new RegExp("(?:^|; )" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "=([^;]*)"),
        );
        return m ? decodeURIComponent(m[1]) : "";
      }

      function setCookie(name, value, days = 400) {
        if (!value) return; // never wipe lang/device with an empty value
        const maxAge = days * 24 * 60 * 60;
        const secure = location.protocol === "https:" ? "; Secure" : "";
        document.cookie = `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
      }

      function localeFor(lang) {
        return lang === "fr" ? "fr-FR" : "en-GB";
      }

      let lang = getCookie(cfg.cookieLang) === "fr" ? "fr" : getCookie(cfg.cookieLang) === "en" ? "en" : "";
      let deviceId = getCookie(cfg.cookieDevice) || "";
      let pendingLang = lang || "en";
      let pendingDevice = deviceId;

      const app = document.getElementById("app");
      const modal = document.getElementById("setup-modal");
      const stepLang = document.getElementById("step-lang");
      const stepDevice = document.getElementById("step-device");
      const langNext = document.getElementById("lang-next");
      const deviceDone = document.getElementById("device-done");
      const deviceSelect = document.getElementById("device");
      const countrySelect = document.getElementById("country");
      const langSelect = document.getElementById("lang");
      const hint = document.getElementById("range-hint");
      const weekPrev = document.getElementById("week-prev");
      const weekNext = document.getElementById("week-next");
      const weekThis = document.getElementById("week-this");
      const weekLabel = document.getElementById("week-label");
      const modalDevice = document.getElementById("modal-device");
      const showRegister = document.getElementById("show-register");
      const registerForm = document.getElementById("register-form");
      const modalDeviceField = document.getElementById("modal-device-field");
      const regName = document.getElementById("reg-name");
      const regPlatform = document.getElementById("reg-platform");
      const regCountry = document.getElementById("reg-country");
      const regSubmit = document.getElementById("reg-submit");
      const regBack = document.getElementById("reg-back");
      const regError = document.getElementById("reg-error");

      function showPickDevice() {
        registerForm.hidden = true;
        regError.hidden = true;
        modalDeviceField.hidden = false;
        showRegister.hidden = false;
        deviceDone.hidden = false;
        deviceDone.disabled = !pendingDevice;
      }

      function showRegisterDevice() {
        pendingDevice = "";
        modalDevice.value = "";
        registerForm.hidden = false;
        regError.hidden = true;
        modalDeviceField.hidden = true;
        showRegister.hidden = true;
        deviceDone.hidden = true;
        deviceDone.disabled = true;
        regName.focus();
      }

      function t() {
        return tAll[lang || pendingLang || "en"];
      }

      function syncDeviceSelect() {
        const allLabel = t().allDevices;
        const current = deviceSelect.value;
        deviceSelect.innerHTML = "";
        const allOpt = document.createElement("option");
        allOpt.value = "";
        allOpt.setAttribute("data-i18n-option", "allDevices");
        allOpt.textContent = allLabel;
        deviceSelect.appendChild(allOpt);
        for (const d of devices) {
          const opt = document.createElement("option");
          opt.value = d.id;
          opt.textContent = `${flag(d.country)} ${d.name}`;
          deviceSelect.appendChild(opt);
        }
        if ([...deviceSelect.options].some((o) => o.value === current)) {
          deviceSelect.value = current;
        } else if (deviceId) {
          deviceSelect.value = deviceId;
        }

        const countries = [...new Set(devices.map((d) => d.country))];
        const cCur = countrySelect.value;
        countrySelect.innerHTML = "";
        const cAll = document.createElement("option");
        cAll.value = "";
        cAll.setAttribute("data-i18n-option", "allCountries");
        cAll.textContent = t().allCountries;
        countrySelect.appendChild(cAll);
        for (const c of countries) {
          const opt = document.createElement("option");
          opt.value = c;
          opt.textContent = `${flag(c)} ${c}`;
          countrySelect.appendChild(opt);
        }
        if ([...countrySelect.options].some((o) => o.value === cCur)) {
          countrySelect.value = cCur;
        }
      }

      function renderDeviceChoices() {
        const placeholder = t().modalDevice;
        modalDevice.innerHTML = "";
        const empty = document.createElement("option");
        empty.value = "";
        empty.textContent = `— ${placeholder} —`;
        modalDevice.appendChild(empty);
        for (const d of devices) {
          const opt = document.createElement("option");
          opt.value = d.id;
          opt.textContent = `${flag(d.country)} ${d.name}`;
          modalDevice.appendChild(opt);
        }
        if (pendingDevice && [...modalDevice.options].some((o) => o.value === pendingDevice)) {
          modalDevice.value = pendingDevice;
        } else {
          modalDevice.value = "";
          pendingDevice = "";
        }
        deviceDone.disabled = !pendingDevice;
      }

      function applyI18n() {
        const m = t();
        const loc = localeFor(lang || pendingLang || "en");
        document.documentElement.lang = lang || pendingLang || "en";

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          const val = m[key];
          if (typeof val === "string") el.textContent = val;
        });

        document.querySelectorAll("[data-i18n-option]").forEach((el) => {
          const key = el.getAttribute("data-i18n-option");
          const val = m[key];
          if (typeof val === "string") el.textContent = val;
        });

        document.querySelectorAll("[data-day-label]").forEach((h2) => {
          const section = h2.closest(".day");
          const iso = section.getAttribute("data-date");
          const isToday = section.getAttribute("data-is-today") === "1";
          const d = new Date(iso);
          const label = d.toLocaleDateString(loc, {
            weekday: "short",
            day: "numeric",
            month: "short",
          });
          h2.textContent = isToday ? `${m.today} · ${label}` : label;
        });

        document.querySelectorAll(".card").forEach((card) => {
          const publish = card.getAttribute("data-publish");
          const timeEl = card.querySelector("[data-time]");
          if (timeEl && publish) {
            timeEl.textContent = new Date(publish).toLocaleTimeString(loc, {
              hour: "2-digit",
              minute: "2-digit",
            });
          }
          const on = card.dataset.published === "1";
          const toggle = card.querySelector(".publish-toggle");
          if (toggle) {
            toggle.setAttribute("aria-label", on ? m.unmarkPublished : m.markPublished);
          }
        });

        if (langSelect && lang) langSelect.value = lang;
      }

      function applyFilters() {
        deviceId = deviceSelect.value || "";
        const country = countrySelect.value || "";
        const m = t();
        const device = devices.find((d) => d.id === deviceId);

        hint.textContent = device
          ? fill(m.showingDevice, {
              name: device.name,
              country: flag(device.country),
            })
          : country
            ? fill(m.showingCountry, { country: flag(country) })
            : m.showingAll;

        document.querySelectorAll(".card").forEach((card) => {
          const cardDevices = (card.getAttribute("data-devices") || card.getAttribute("data-device") || "")
            .split(",")
            .filter(Boolean);
          const cardCountries = (card.getAttribute("data-countries") || card.getAttribute("data-country") || "")
            .split(",")
            .filter(Boolean);
          const okDevice = !deviceId || cardDevices.includes(deviceId);
          const okCountry = !country || cardCountries.includes(country);
          card.hidden = !(okDevice && okCountry);
        });

        document.querySelectorAll(".day").forEach((section) => {
          const cards = [...section.querySelectorAll(".card")];
          const visible = cards.filter((c) => !c.hidden);
          const empty = section.querySelector("[data-empty]");
          const grid = section.querySelector(".day-grid");
          if (empty) empty.hidden = visible.length > 0;
          if (grid) grid.hidden = visible.length === 0;
        });
      }

      function finishWithDevice(id) {
        deviceId = id;
        pendingDevice = id;
        setCookie(cfg.cookieDevice, deviceId);
        showApp();
      }

      function showApp() {
        modal.hidden = true;
        app.hidden = false;
        syncDeviceSelect();
        // Default view = cookie device (select + country stay in sync).
        // User can still switch the dropdown to "all devices".
        const saved = getCookie(cfg.cookieDevice) || deviceId || "";
        const d = devices.find((x) => x.id === saved);
        if (d) {
          deviceSelect.value = d.id;
          countrySelect.value = d.country;
          deviceId = d.id;
        } else {
          deviceSelect.value = "";
          countrySelect.value = "";
          deviceId = "";
        }
        renderCalendar();
        applyI18n();
        applyFilters();
      }

      function openSetup(force = false) {
        const needLang = force || !getCookie(cfg.cookieLang);
        const needDevice = force || !getCookie(cfg.cookieDevice);
        if (!needLang && !needDevice && !force) {
          showApp();
          return;
        }
        app.hidden = true;
        modal.hidden = false;
        pendingLang = lang || "en";
        pendingDevice = deviceId || "";
        stepLang.hidden = false;
        stepDevice.hidden = true;
        langNext.disabled = !pendingLang;
        renderDeviceChoices();
        showPickDevice();
        document.querySelectorAll("#lang-choices .choice").forEach((b) => {
          b.classList.toggle("selected", b.dataset.lang === pendingLang);
        });
        applyI18n();
      }

      document.querySelectorAll("#lang-choices .choice").forEach((btn) => {
        btn.addEventListener("click", () => {
          pendingLang = btn.dataset.lang;
          document.querySelectorAll("#lang-choices .choice").forEach((b) => {
            b.classList.toggle("selected", b === btn);
          });
          langNext.disabled = false;
          applyI18n();
        });
      });

      langNext.addEventListener("click", () => {
        lang = pendingLang;
        setCookie(cfg.cookieLang, lang);
        stepLang.hidden = true;
        stepDevice.hidden = false;
        renderDeviceChoices();
        applyI18n();
      });

      modalDevice.addEventListener("change", () => {
        pendingDevice = modalDevice.value || "";
        if (pendingDevice) showPickDevice();
        else deviceDone.disabled = true;
      });

      showRegister.addEventListener("click", () => {
        showRegisterDevice();
      });

      regBack.addEventListener("click", () => {
        showPickDevice();
      });

      function normalizeNameLive(raw) {
        return raw
          .toLowerCase()
          .replace(/\s+/g, "-")
          .replace(/[^a-z0-9-]+/g, "-")
          .replace(/-+/g, "-");
      }

      regName.addEventListener("input", () => {
        const start = regName.selectionStart;
        const next = normalizeNameLive(regName.value);
        if (next !== regName.value) {
          regName.value = next;
          const pos = Math.min(start, next.length);
          regName.setSelectionRange(pos, pos);
        }
      });

      regSubmit.addEventListener("click", async () => {
        const name = normalizeNameLive(regName.value).replace(/^-|-$/g, "");
        regName.value = name;
        const country = regCountry.value;
        regError.hidden = true;
        if (!name) {
          regError.textContent = t().modalRegisterError;
          regError.hidden = false;
          return;
        }
        regSubmit.disabled = true;
        try {
          const res = await fetch("/api/devices", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              name,
              country,
              platform: regPlatform.value || "tiktok",
            }),
          });
          const body = await res.json();
          if (!res.ok) throw new Error(body.error || "failed");
          devices.push(body.device);
          devices.sort((a, b) => a.name.localeCompare(b.name));
          finishWithDevice(body.device.id);
        } catch (err) {
          regError.textContent = t().modalRegisterError;
          regError.hidden = false;
        } finally {
          regSubmit.disabled = false;
        }
      });

      deviceDone.addEventListener("click", () => {
        if (!pendingDevice) return;
        finishWithDevice(pendingDevice);
      });

      deviceSelect.addEventListener("change", () => {
        deviceId = deviceSelect.value;
        // Keep the last real device in the cookie — "all devices" is a view
        // filter only, otherwise the next visit thinks setup is missing.
        if (deviceId) setCookie(cfg.cookieDevice, deviceId);
        const d = devices.find((x) => x.id === deviceId);
        // Sync country with the picked device; clear it for "all devices"
        // so FR + US (etc.) all show up.
        countrySelect.value = d ? d.country : "";
        applyFilters();
      });

      countrySelect.addEventListener("change", applyFilters);

      weekPrev.addEventListener("click", () => {
        weekOffset -= 7;
        renderCalendar();
        applyI18n();
        applyFilters();
      });

      weekNext.addEventListener("click", () => {
        weekOffset += 7;
        renderCalendar();
        applyI18n();
        applyFilters();
      });

      weekThis.addEventListener("click", () => {
        weekOffset = 0;
        renderCalendar();
        applyI18n();
        applyFilters();
      });

      langSelect.addEventListener("change", () => {
        lang = langSelect.value;
        setCookie(cfg.cookieLang, lang);
        renderCalendar();
        applyI18n();
        applyFilters();
      });

      document.getElementById("reopen-setup").addEventListener("click", () => {
        openSetup(true);
      });

      if (!getCookie(cfg.cookieLang) || !getCookie(cfg.cookieDevice)) {
        openSetup(false);
      } else {
        lang = getCookie(cfg.cookieLang) === "fr" ? "fr" : "en";
        deviceId = getCookie(cfg.cookieDevice);
        showApp(); // filters on cookie device by default
      }
    </script>
  </body>
</html>
