---
export const prerender = false;

import "../styles/global.css";
import {
  ACCOUNT_PLATFORMS,
  COUNTRY_CODES,
  COUNTRY_FLAGS,
  countryFlag,
  listDevices,
} from "../lib/devices";
import { COOKIE_LANG, messages, UI_LANGS } from "../lib/i18n";
import { PLATFORM_ICON } from "../lib/platform-icons";

const devices = await listDevices();

const boot = {
  devices,
  platforms: ACCOUNT_PLATFORMS,
  countries: COUNTRY_CODES,
  flags: COUNTRY_FLAGS,
  platformIcons: PLATFORM_ICON,
  langs: UI_LANGS,
  messages,
  cookieLang: COOKIE_LANG,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Magnet · Accounts</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Serif:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap accounts-page" id="app">
      <header>
        <div class="header-row">
          <div>
            <h1 data-i18n="accountsTitle">Accounts</h1>
            <p data-i18n="accountsSubtitle">Platform and warm-up for each account.</p>
          </div>
          <nav class="nav-links">
            <a href="/" data-i18n="navCalendar">Calendar</a>
            <a href="/accounts" class="nav-current" data-i18n="navAccounts">Accounts</a>
          </nav>
        </div>
      </header>

      <div class="pickers">
        <label class="field">
          <span data-i18n="language">Language</span>
          <select id="lang" aria-label="Language">
            {UI_LANGS.map((l) => (
              <option value={l.id}>{l.label}</option>
            ))}
          </select>
        </label>
      </div>

      <section class="account-add">
        <h2 data-i18n="accountAdd">Add account</h2>
        <form id="add-form" class="account-add-form">
          <label class="field">
            <span data-i18n="accountName">Account</span>
            <input id="add-name" type="text" maxlength="60" required autocomplete="off" />
          </label>
          <label class="field">
            <span data-i18n="accountPlatform">Platform</span>
            <select id="add-platform" required>
              <option value="tiktok" data-i18n-option="accountPlatformTiktok">TikTok</option>
              <option value="instagram" data-i18n-option="accountPlatformInstagram">Instagram</option>
            </select>
          </label>
          <label class="field">
            <span data-i18n="country">Country</span>
            <select id="add-country" required>
              {COUNTRY_CODES.map((c) => (
                <option value={c}>
                  {countryFlag(c)} {c}
                </option>
              ))}
            </select>
          </label>
          <label class="field field-check">
            <span data-i18n="accountWarmup">Warm-up</span>
            <label class="check-row">
              <input id="add-warmup" type="checkbox" />
              <span data-i18n="accountWarmupOn">In warm-up</span>
            </label>
          </label>
          <label class="field" id="add-warmup-date-field" hidden>
            <span data-i18n="accountWarmupStart">Start date</span>
            <input id="add-warmup-date" type="date" />
          </label>
          <button type="submit" class="primary account-add-btn" data-i18n="accountAddSubmit">
            Add
          </button>
        </form>
        <p class="register-error" id="add-error" hidden></p>
      </section>

      <p class="empty accounts-empty" id="accounts-empty" data-i18n="accountEmpty" hidden>
        No accounts yet.
      </p>
      <div class="accounts-table-wrap" id="accounts-table-wrap" hidden>
        <table class="accounts-table">
          <thead>
            <tr>
              <th data-i18n="accountName">Account</th>
              <th data-i18n="accountPlatform">Platform</th>
              <th data-i18n="country">Country</th>
              <th data-i18n="accountWarmup">Warm-up</th>
              <th data-i18n="accountWarmupStart">Start date</th>
              <th></th>
              <th></th>
            </tr>
          </thead>
          <tbody id="accounts-list"></tbody>
        </table>
      </div>
    </div>

    <script define:vars={{ boot }}>
      const cfg = boot;
      let devices = [...(cfg.devices || [])];
      const platforms = [...(cfg.platforms || ["tiktok", "instagram"])];
      const countries = [...(cfg.countries || ["FR", "US", "UK"])];
      const tAll = cfg.messages;
      const flags = cfg.flags || {};
      const platformIcons = cfg.platformIcons || {
        instagram: "/icons/instagram.png",
        tiktok: "/icons/tiktok.png",
      };

      function getCookie(name) {
        const m = document.cookie.match(
          new RegExp("(?:^|; )" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "=([^;]*)"),
        );
        return m ? decodeURIComponent(m[1]) : "";
      }

      function setCookie(name, value, days = 400) {
        if (!value) return;
        const maxAge = days * 24 * 60 * 60;
        const secure = location.protocol === "https:" ? "; Secure" : "";
        document.cookie = `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
      }

      let lang = getCookie(cfg.cookieLang) === "fr" ? "fr" : "en";

      function t() {
        return tAll[lang] || tAll.en;
      }

      function fill(template, vars) {
        return template.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");
      }

      function flag(country) {
        return flags[country] || country;
      }

      function platformLabel(platform, m) {
        return platform === "instagram"
          ? m.accountPlatformInstagram
          : m.accountPlatformTiktok;
      }

      function platformIconEl(platform) {
        const key = platform === "instagram" ? "instagram" : "tiktok";
        const el = document.createElement("span");
        el.className = "platform-icon lg";
        el.dataset.platform = key;
        el.setAttribute("role", "img");
        el.setAttribute("aria-label", key === "instagram" ? "Instagram" : "TikTok");
        el.style.setProperty("--icon", `url('${platformIcons[key]}')`);
        return el;
      }

      function todayKey() {
        const d = new Date();
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const day = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${day}`;
      }

      function dayCount(start) {
        if (!start) return null;
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(start);
        if (!m) return null;
        const a = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
        const now = new Date();
        const b = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const ms = b.getTime() - a.getTime();
        if (ms < 0) return 0;
        return Math.floor(ms / 86400000) + 1;
      }

      const listEl = document.getElementById("accounts-list");
      const tableWrap = document.getElementById("accounts-table-wrap");
      const emptyEl = document.getElementById("accounts-empty");
      const langSelect = document.getElementById("lang");
      const addForm = document.getElementById("add-form");
      const addName = document.getElementById("add-name");
      const addPlatform = document.getElementById("add-platform");
      const addCountry = document.getElementById("add-country");
      const addWarmup = document.getElementById("add-warmup");
      const addWarmupDateField = document.getElementById("add-warmup-date-field");
      const addWarmupDate = document.getElementById("add-warmup-date");
      const addError = document.getElementById("add-error");

      function applyI18n() {
        const m = t();
        document.documentElement.lang = lang;
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (typeof m[key] === "string") el.textContent = m[key];
        });
        document.querySelectorAll("[data-i18n-option]").forEach((el) => {
          const key = el.getAttribute("data-i18n-option");
          if (typeof m[key] === "string") el.textContent = m[key];
        });
        if (langSelect) langSelect.value = lang;
      }

      async function patchDevice(id, body) {
        const res = await fetch("/api/devices", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id, ...body }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "failed");
        const idx = devices.findIndex((d) => d.id === id);
        if (idx >= 0) devices[idx] = data.device;
        return data.device;
      }

      function renderList() {
        const m = t();
        listEl.innerHTML = "";
        emptyEl.hidden = devices.length > 0;
        tableWrap.hidden = devices.length === 0;

        for (const account of devices) {
          const days = dayCount(account.warmupStartedAt);
          const tr = document.createElement("tr");
          tr.dataset.id = account.id;

          const nameTd = document.createElement("td");
          nameTd.className = "account-name";
          const nameWrap = document.createElement("span");
          nameWrap.className = "account-with-icon";
          const nameIcon = platformIconEl(account.platform);
          nameWrap.appendChild(nameIcon);
          nameWrap.appendChild(document.createTextNode(account.name));
          nameTd.appendChild(nameWrap);
          tr.appendChild(nameTd);

          const platformTd = document.createElement("td");
          const platformWrap = document.createElement("div");
          platformWrap.className = "platform-select-wrap";
          const platformIcon = platformIconEl(account.platform);
          const platformSelect = document.createElement("select");
          platformSelect.className = "table-select";
          for (const p of platforms) {
            const opt = document.createElement("option");
            opt.value = p;
            opt.textContent = platformLabel(p, m);
            platformSelect.appendChild(opt);
          }
          platformSelect.value = account.platform || "tiktok";
          platformSelect.addEventListener("change", async () => {
            platformSelect.disabled = true;
            try {
              const updated = await patchDevice(account.id, {
                platform: platformSelect.value,
              });
              account.platform = updated.platform;
              renderList();
              applyI18n();
            } catch {
              platformSelect.value = account.platform || "tiktok";
              alert(m.accountSaveError);
              platformSelect.disabled = false;
            }
          });
          platformWrap.append(platformIcon, platformSelect);
          platformTd.appendChild(platformWrap);
          tr.appendChild(platformTd);

          const countryTd = document.createElement("td");
          const countrySelect = document.createElement("select");
          countrySelect.className = "table-select";
          for (const c of countries) {
            const opt = document.createElement("option");
            opt.value = c;
            opt.textContent = `${flag(c)} ${c}`;
            countrySelect.appendChild(opt);
          }
          countrySelect.value = account.country;
          countrySelect.addEventListener("change", async () => {
            countrySelect.disabled = true;
            try {
              const updated = await patchDevice(account.id, {
                country: countrySelect.value,
              });
              account.country = updated.country;
            } catch {
              countrySelect.value = account.country;
              alert(m.accountSaveError);
            } finally {
              countrySelect.disabled = false;
            }
          });
          countryTd.appendChild(countrySelect);
          tr.appendChild(countryTd);

          const warmupTd = document.createElement("td");
          warmupTd.className = "account-warmup-cell";
          const check = document.createElement("input");
          check.type = "checkbox";
          check.checked = Boolean(account.warmupStartedAt);
          check.title = check.checked ? m.accountWarmupOn : m.accountWarmupOff;
          warmupTd.appendChild(check);
          tr.appendChild(warmupTd);

          const dateTd = document.createElement("td");
          const dateInput = document.createElement("input");
          dateInput.type = "date";
          dateInput.className = "table-date";
          dateInput.value = account.warmupStartedAt || "";
          dateInput.disabled = !account.warmupStartedAt;
          dateTd.appendChild(dateInput);
          tr.appendChild(dateTd);

          const daysTd = document.createElement("td");
          daysTd.className = days != null ? "account-days is-on" : "account-days";
          daysTd.textContent = days != null ? fill(m.accountDays, { n: String(days) }) : "—";
          tr.appendChild(daysTd);

          async function saveWarmup(startedAt) {
            check.disabled = true;
            dateInput.disabled = true;
            try {
              const updated = await patchDevice(account.id, {
                warmupStartedAt: startedAt,
              });
              account.warmupStartedAt = updated.warmupStartedAt;
              const n = dayCount(account.warmupStartedAt);
              daysTd.className = n != null ? "account-days is-on" : "account-days";
              daysTd.textContent = n != null ? fill(m.accountDays, { n: String(n) }) : "—";
              check.checked = Boolean(account.warmupStartedAt);
              check.title = check.checked ? m.accountWarmupOn : m.accountWarmupOff;
              dateInput.value = account.warmupStartedAt || "";
              dateInput.disabled = !account.warmupStartedAt;
            } catch {
              check.checked = Boolean(account.warmupStartedAt);
              dateInput.value = account.warmupStartedAt || "";
              dateInput.disabled = !account.warmupStartedAt;
              alert(m.accountSaveError);
            } finally {
              check.disabled = false;
              if (account.warmupStartedAt) dateInput.disabled = false;
            }
          }

          check.addEventListener("change", () => {
            if (check.checked) {
              dateInput.disabled = false;
              if (!dateInput.value) dateInput.value = todayKey();
              saveWarmup(dateInput.value);
            } else {
              saveWarmup(null);
            }
          });
          dateInput.addEventListener("change", () => {
            if (!check.checked) return;
            saveWarmup(dateInput.value || todayKey());
          });

          const delTd = document.createElement("td");
          delTd.className = "account-actions";
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linkish account-delete";
          del.setAttribute("data-i18n", "accountDelete");
          del.textContent = m.accountDelete;
          del.addEventListener("click", async () => {
            del.disabled = true;
            try {
              const res = await fetch("/api/devices", {
                method: "DELETE",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ id: account.id }),
              });
              if (!res.ok) throw new Error("failed");
              devices = devices.filter((d) => d.id !== account.id);
              renderList();
              applyI18n();
            } catch {
              alert(m.accountSaveError);
              del.disabled = false;
            }
          });
          delTd.appendChild(del);
          tr.appendChild(delTd);

          listEl.appendChild(tr);
        }
      }

      addWarmup.addEventListener("change", () => {
        addWarmupDateField.hidden = !addWarmup.checked;
        if (addWarmup.checked && !addWarmupDate.value) {
          addWarmupDate.value = todayKey();
        }
      });

      addForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        addError.hidden = true;
        const name = addName.value.trim();
        if (!name) return;
        const submit = addForm.querySelector("button[type=submit]");
        submit.disabled = true;
        try {
          const res = await fetch("/api/devices", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              name,
              platform: addPlatform.value,
              country: addCountry.value,
              warmupStartedAt: addWarmup.checked
                ? addWarmupDate.value || todayKey()
                : null,
            }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "failed");
          devices.push(data.device);
          devices.sort((a, b) => a.name.localeCompare(b.name));
          addName.value = "";
          addPlatform.value = "tiktok";
          addWarmup.checked = false;
          addWarmupDateField.hidden = true;
          addWarmupDate.value = "";
          renderList();
          applyI18n();
        } catch {
          addError.textContent = t().accountSaveError;
          addError.hidden = false;
        } finally {
          submit.disabled = false;
        }
      });

      langSelect.addEventListener("change", () => {
        lang = langSelect.value === "fr" ? "fr" : "en";
        setCookie(cfg.cookieLang, lang);
        renderList();
        applyI18n();
      });

      renderList();
      applyI18n();
    </script>
  </body>
</html>
