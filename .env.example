# UploadThing — same pattern as Astro (dashboard → API keys)
UPLOADTHING_TOKEN=

# Protects POST /api/items (CLI / AI only)
INBOX_SECRET=change-me

# Optional: base URL of the deployed app (CLI remote register)
# SCHEDULER_URL=https://your-app.vercel.app

# Optional: Vercel Blob for durable schedule on serverless
# Without it, local/dev uses data/schedule.json
# BLOB_READ_WRITE_TOKEN=
