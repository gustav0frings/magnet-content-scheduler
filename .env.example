# Required to push videos (`npm run send`) and for the Vercel app to read the schedule.
# Same token as the Astro project — https://uploadthing.com → API keys
UPLOADTHING_TOKEN=

# Required when scheduling to an account with postizIntegrationId set
# AND for calendar views + /performance charts on the Vercel webapp
# (Postiz Settings → Developers → Public API)
# CLI local (.env) + Vercel project env — same key
POSTIZ_API_KEY=

# Optional: protect POST /api/items if you register via HTTP instead of the CLI
# INBOX_SECRET=change-me
